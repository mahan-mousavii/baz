YHTTP_ENV=development
PUBLIC_URL=http://127.0.0.1:8080
DATABASE_URL=postgresql://localhost/mahnil-digital

# Set these before enabling the admin login. There are no default credentials.
YHTTP_ADMIN_USERNAME=
YHTTP_ADMIN_PASSWORD=
YHTTP_AUTH_ACCESS_SECRET=

# yhttp-auth uses Redis for session revocation checks.
YHTTP_AUTH_REDIS_HOST=localhost
YHTTP_AUTH_REDIS_PORT=6379
YHTTP_AUTH_REDIS_DB=0

# Local development uses a persistent private directory. Production defaults
# to S3 and requires a bucket configuration before media operations can work.
MEDIA_STORAGE_BACKEND=local
MEDIA_STORAGE_DIR=.var/media-private
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=
MEDIA_S3_ENDPOINT=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
